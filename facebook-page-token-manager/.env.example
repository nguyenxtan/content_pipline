PORT=4001
DATABASE_URL=postgres://postgres:postgres@postgres:5432/facebook_page_token_manager
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:4001/auth/facebook/callback
FACEBOOK_API_VERSION=v25.0
TOKEN_ENCRYPTION_KEY_BASE64=replace_with_32_byte_base64_key
TOKEN_WARNING_DAYS=14
TOKEN_MONITOR_INTERVAL_MS=86400000
STATE_SIGNING_SECRET=replace_with_random_state_signing_secret
